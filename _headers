# Cloudflare Pages / Netlify headers config
# One file for both hosts. Applies response headers to matching paths.

# Sensible defaults — applied to every file
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Long cache for truly-static assets
/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, must-revalidate

/og-image.png
  Cache-Control: public, max-age=604800, must-revalidate

/portrait.jpg
  Cache-Control: public, max-age=604800, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned assets (cache-busted via ?v=) — cache hard
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/theme.js
  Cache-Control: public, max-age=31536000, immutable

# Essay images (never glob /notes/* — that would cache the HTML pages)
/notes/by-invitation-only/sf-marin-headlands.jpg
  Cache-Control: public, max-age=604800, must-revalidate

/notes/by-invitation-only/naval-ravikant.jpg
  Cache-Control: public, max-age=604800, must-revalidate

/notes/by-invitation-only/ben-horowitz.jpg
  Cache-Control: public, max-age=604800, must-revalidate

/notes/by-invitation-only/sf-marin-headlands.webp
  Cache-Control: public, max-age=604800, must-revalidate

